[global]
    origin = top-center
    offset = (0, 35)

    width = 420
    height = (70, 70)

    transparency = 0

    corner_radius = 0
    frame_width = 2
    font = JetBrainsMono Nerd Font 10

[urgency_low]
    background = "#00000099"
    foreground = "#6e6a86"
    frame_color = "#403d52"

[urgency_normal]
    background = "#00000099"
    foreground = "#e0def4"
    frame_color = "#9ccfd8"

[urgency_critical]
    background = "#00000099"
    foreground = "#eb6f92"
    frame_color = "#eb6f92"
